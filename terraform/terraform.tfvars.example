# Copy to terraform.tfvars and update the repository name.
aws_region   = "eu-central-1"
project_name = "cloud-devops-assessment"
environment  = "assessment"
github_repo  = "YOUR_GITHUB_USERNAME/YOUR_REPOSITORY"
db_name      = "assessment"
db_username  = "assessment_admin"
db_instance_class = "db.t3.micro"
ecs_desired_count = 0
